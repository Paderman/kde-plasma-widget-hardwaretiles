[Unit]
Description=Publish processor power draw (coarse, 1 s average) to /run/sensordeck-power (Sensor Deck, unprivileged)
After=systemd-modules-load.service systemd-udev-settle.service

[Service]
Type=simple
# reads only /sys/class/powercap/*-rapl:*/energy_uj (group power-sensors via udev rule)
# and publishes 1-second averages rounded to 0.1 W – never the raw counters
ExecStart=/usr/bin/python3 -I /usr/local/libexec/sensordeck-power-reader --serve /run/sensordeck-power 1
Restart=on-failure
RestartSec=10
Nice=10

# no root: throw-away user, only member of power-sensors
DynamicUser=yes
SupplementaryGroups=power-sensors
RuntimeDirectory=sensordeck-power
RuntimeDirectoryMode=0755
UMask=0022

# hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
