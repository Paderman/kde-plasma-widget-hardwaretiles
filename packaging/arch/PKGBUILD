pkgname=plasma6-applets-sensordeck
pkgver=1.0.0
pkgrel=1
pkgdesc="GPU & system monitor widget for KDE Plasma 6 (VRAM temperature, throttling, fan curve, CPU, SSDs, fans)"
arch=('any')
url="https://github.com/Paderman/sensordeck"
license=('GPL-2.0-or-later')
depends=('plasma-workspace')
makedepends=('gettext')
optdepends=('lm_sensors: mainboard fans and fan names, sensor chip detection'
            'pciutils: graphics card names'
            'nvidia-utils: detailed values of NVIDIA cards')
source=("sensordeck-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # replace with the real checksum when publishing to the AUR

package() {
    cd "sensordeck-$pkgver"
    sh packaging/stage.sh "$pkgdir"
    rm -rf "$pkgdir/usr/share/doc/sensordeck/README.de.md"
}
