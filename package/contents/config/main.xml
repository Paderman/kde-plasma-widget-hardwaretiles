<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- JSON array of tile definitions; empty = built-in defaults (Defaults.js) -->
    <entry name="items" type="String"><default></default></entry>
    <!-- PCI address of the graphics card this widget shows; empty = first discrete GPU -->
    <entry name="gpuAddress" type="String"><default></default></entry>
    <!-- false until the setup wizard ran (or an existing layout was found) -->
    <entry name="setupDone" type="Bool"><default>false</default></entry>
    <!-- layout template the tiles were last loaded from: system | allgpus | gpu | wizard | "" (own) -->
    <entry name="layoutPreset" type="String"><default></default></entry>
    <!-- fingerprint of the tiles right after loading it (Defaults.signature) – differs once tiles are changed -->
    <entry name="layoutHash" type="String"><default></default></entry>
    <!-- learned fan curves, kept across restarts: JSON {tileId: {pair: "x|y sources", bins: {°C: [y, n]}}} -->
    <entry name="curveData" type="String"><default></default></entry>
    <!-- "tileId@time": the tile menu's "bearbeiten" – the settings page scrolls to that tile
         (only if set in the last 15 s, so an old value does nothing) -->
    <entry name="editTile" type="String"><default></default></entry>
    <!-- "page@time": open the settings on that page (e.g. "ConfigProfiles.qml") – Plasma always
         starts on the first page, which then switches (only if set in the last 15 s) -->
    <entry name="openPage" type="String"><default></default></entry>
    <!-- old switch (until v5): false = never group; read only for migration -->
    <entry name="gpuSections" type="Bool"><default>true</default></entry>
    <!-- sections per graphics card: "auto" (from two cards on) | "always" | "never"; "" = from gpuSections -->
    <entry name="gpuSectionMode" type="String"><default></default></entry>
    <!-- desktop: shrink tiles so everything fits without scrolling -->
    <entry name="fitToSize" type="Bool"><default>true</default></entry>
    <!-- 0 = automatic -->
    <entry name="columns" type="Int"><default>0</default></entry>
    <entry name="updateInterval" type="Int"><default>1500</default></entry>
    <entry name="historyLength" type="Int"><default>60</default></entry>
    <entry name="tileStyle" type="String"><default>glass</default></entry>
    <entry name="tileScale" type="Int"><default>100</default></entry>
    <!-- live preview of the size slider while the settings are open (0 = none) -->
    <entry name="tileScalePreview" type="Int"><default>0</default></entry>
    <!-- background on the desktop in percent; 100 = the normal Plasma frame -->
    <entry name="backgroundOpacity" type="Int"><default>100</default></entry>
    <!-- live preview while the settings are open; -1 = none -->
    <entry name="backgroundOpacityPreview" type="Int"><default>-1</default></entry>
    <!-- tiles and main card while the settings are open: {"items":…,"gpu":…}; empty = none -->
    <entry name="layoutPreview" type="String"><default></default></entry>
    <entry name="panelShowLabels" type="Bool"><default>false</default></entry>
    <entry name="panelShowRings" type="Bool"><default>true</default></entry>
    <!-- JSON array of tile ids: order before the first manual move (target of "reset") -->
    <entry name="baseOrder" type="String"><default></default></entry>
    <entry name="alertsEnabled" type="Bool"><default>true</default></entry>
    <entry name="alertOnWarn" type="Bool"><default>false</default></entry>
    <entry name="alertRecovery" type="Bool"><default>true</default></entry>
    <entry name="alertDelay" type="Int"><default>5</default></entry>
    <entry name="alertCooldown" type="Int"><default>10</default></entry>
    <entry name="alertHysteresis" type="Int"><default>3</default></entry>
    <!-- graphics card fans (NVIDIA): warn when a fan stands still although the card wants it to turn,
         or runs slower than fanSlowPercent % of the fastest fan of the card at the same target -->
    <entry name="fanWatch" type="Bool"><default>true</default></entry>
    <entry name="fanSlowPercent" type="Int"><default>50</default></entry>
    <!-- profiles (Profiles.js): JSON [{name, saved, hw, data}]; name of the profile loaded last;
         the view before the last profile was loaded: JSON {name, data} ("" = none) -->
    <entry name="profiles" type="String"><default></default></entry>
    <entry name="activeProfile" type="String"><default></default></entry>
    <entry name="profileBackup" type="String"><default></default></entry>
    <!-- update check: off until the user agrees; updateAsked = the question was answered -->
    <entry name="updateCheck" type="Bool"><default>false</default></entry>
    <entry name="updateAsked" type="Bool"><default>false</default></entry>
    <!-- unix time of the last automatic check, newest version found, version the user dismissed -->
    <entry name="updateLastCheck" type="Int"><default>0</default></entry>
    <entry name="updateLatest" type="String"><default></default></entry>
    <entry name="updateUrl" type="String"><default></default></entry>
    <entry name="updateDismissed" type="String"><default></default></entry>
  </group>
</kcfg>
