#: package/contents/ui/ConfigAlerts.qml:59
msgid "Warn again only:"
msgstr "Volver a avisar solo:"

#: package/contents/ui/ConfigAlerts.qml:61
msgid "%1 below the threshold"
msgstr "%1 por debajo del umbral"

#: package/contents/ui/ConfigAlerts.qml:68
