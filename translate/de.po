#: package/contents/ui/ConfigAlerts.qml:44
msgid "Notify on critical values"
msgstr "Bei kritischen Werten benachrichtigen"

#: package/contents/ui/ConfigAlerts.qml:50
msgid "Also when the warning threshold is reached"
msgstr "Auch bei Erreichen der Warnschwelle"

#: package/contents/ui/ConfigAlerts.qml:56
msgid "All-clear when the value is back to normal"
msgstr "Entwarnung, wenn der Wert wieder normal ist"

#: package/contents/ui/ConfigAlerts.qml:63
msgid "Trigger after:"
