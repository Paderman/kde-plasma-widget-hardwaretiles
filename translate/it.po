#: package/contents/config/config.qml:9
msgid "Sensors"
msgstr "Sensori"

#: package/contents/config/config.qml:14 package/contents/ui/FullView.qml:966
msgid "Notifications"
msgstr "Notifiche"

#: package/contents/config/config.qml:19 package/contents/ui/FullView.qml:935
msgid "Appearance"
msgstr "Aspetto"

#: package/contents/config/config.qml:24
#: package/contents/ui/ConfigSensors.qml:79
msgid "Profiles"
msgstr "Profili"

#: package/contents/config/config.qml:29
msgid "About & updates"
msgstr "Informazioni e aggiornamenti"

#: package/contents/ui/ConfigAbout.qml:51
msgid "Exit code %1"
msgstr "Codice di uscita %1"

#: package/contents/ui/ConfigAbout.qml:56
msgid "Restart Plasma desktop?"
msgstr "Riavviare il desktop Plasma?"

#: package/contents/ui/ConfigAbout.qml:57
msgid "Desktop, panels and widgets disappear for a few seconds and then start again. Open programs keep running. This settings window closes – changes that have not been applied are lost."
msgstr "Desktop, pannelli e widget scompaiono per qualche secondo e poi ripartono. I programmi aperti continuano a funzionare. Questa finestra delle impostazioni si chiude – le modifiche non applicate vanno perse."

#: package/contents/ui/ConfigAbout.qml:61
msgid "Restart"
msgstr "Riavvia"

#: package/contents/ui/ConfigAbout.qml:70
#: package/contents/ui/ConfigProfiles.qml:159
#: package/contents/ui/SetupWizard.qml:350
msgid "Cancel"
msgstr "Annulla"

#: package/contents/ui/ConfigAbout.qml:96
msgid "Version:"
msgstr "Versione:"

#: package/contents/ui/ConfigAbout.qml:100
msgid "Licence:"
msgstr "Licenza:"

#: package/contents/ui/ConfigAbout.qml:104
msgid "Links:"
msgstr "Collegamenti:"

#: package/contents/ui/ConfigAbout.qml:106
msgid "Website"
msgstr "Sito web"

#: package/contents/ui/ConfigAbout.qml:111
msgid "Report a problem"
msgstr "Segnala un problema"

#: package/contents/ui/ConfigAbout.qml:116
msgid "Hardware not detected"
msgstr "Hardware non rilevato"

#: package/contents/ui/ConfigAbout.qml:121
msgid "“Report a problem” and “Hardware not detected” each open a form on GitHub."
msgstr "«Segnala un problema» e «Hardware non rilevato» aprono ciascuno un modulo su GitHub."

#: package/contents/ui/ConfigAbout.qml:128
msgid "Updates:"
msgstr "Aggiornamenti:"

#: package/contents/ui/ConfigAbout.qml:131
msgid "Look for new versions once a week"
msgstr "Cerca nuove versioni una volta alla settimana"

#: package/contents/ui/ConfigAbout.qml:136
msgid "Once a week the widget asks GitHub for the newest version number and shows a note in the widget when a new version is out."
msgstr "Una volta alla settimana il widget chiede a GitHub il numero dell'ultima versione e mostra un avviso nel widget quando è uscita una nuova versione."

#: package/contents/ui/ConfigAbout.qml:141
msgid "Check now"
msgstr "Controlla ora"

#: package/contents/ui/ConfigAbout.qml:155
msgid "You have the latest version."
msgstr "È installata la versione più recente."

#: package/contents/ui/ConfigAbout.qml:156
msgid "Version %1 is available."
msgstr "È disponibile la versione %1."

#: package/contents/ui/ConfigAbout.qml:157
msgid "No version has been published yet."
msgstr "Non è ancora stata pubblicata alcuna versione."

#: package/contents/ui/ConfigAbout.qml:158
msgid "GitHub could not be reached (%1)."
msgstr "Impossibile raggiungere GitHub (%1)."

#: package/contents/ui/ConfigAbout.qml:165 package/contents/ui/FullView.qml:427
msgid "Open download page"
msgstr "Apri la pagina di download"

#: package/contents/ui/ConfigAbout.qml:170
msgid "Installed via “Get New Widgets” or Discover? Then Discover installs updates for you – the check here only informs you."
msgstr "Installato tramite «Scarica nuovi widget» o Discover? Allora Discover installa gli aggiornamenti – il controllo qui serve solo da informazione."

#: package/contents/ui/ConfigAbout.qml:180
msgid "Privacy: the check only runs when you allow it or click “Check now”. Your computer then asks api.github.com for the newest version number. GitHub sees your IP address, as with any website visit; Hardware Tiles sends no other data and keeps no statistics. Details: <a href=\"%1\">GitHub privacy statement</a>."
msgstr "Privacy: il controllo avviene solo se è consentito o con un clic su «Controlla ora». Il computer chiede allora ad api.github.com il numero dell’ultima versione. GitHub vede l’indirizzo IP, come per ogni visita a un sito web; Hardware Tiles non invia altri dati e non raccoglie statistiche. Dettagli: <a href=\"%1\">informativa sulla privacy di GitHub</a>."

#: package/contents/ui/ConfigAbout.qml:187
msgid "Troubleshooting:"
msgstr "Risoluzione dei problemi:"

#: package/contents/ui/ConfigAbout.qml:189
msgid "Restart Plasma desktop …"
msgstr "Riavvia il desktop Plasma…"

#: package/contents/ui/ConfigAbout.qml:194
msgid "Helps when the widget or the desktop no longer reacts properly, e.g. after an update. Same as “systemctl --user restart plasma-plasmashell” in a terminal. If it happens again, please report it with “Report a problem”."
msgstr "Utile quando il widget o il desktop non reagiscono più correttamente, ad es. dopo un aggiornamento. Equivale a “systemctl --user restart plasma-plasmashell” in un terminale. Se succede di nuovo, è utile segnalarlo con «Segnala un problema»."

#: package/contents/ui/ConfigAbout.qml:202
msgid "Plasma could not be restarted: %1"
msgstr "Impossibile riavviare Plasma: %1"

#: package/contents/ui/ConfigAlerts.qml:41
msgid "Notifications:"
msgstr "Notifiche:"

#: package/contents/ui/ConfigAlerts.qml:45
msgid "Notify on critical values"
msgstr "Notifica in caso di valori critici"

#: package/contents/ui/ConfigAlerts.qml:48
msgid "Critical notifications stay until you close them and also appear in “Do not disturb” mode."
msgstr "Le notifiche critiche restano finché non vengono chiuse e compaiono anche in modalità «Non disturbare»."

#: package/contents/ui/ConfigAlerts.qml:56
msgid "Also when the warning threshold is reached"
msgstr "Anche al raggiungimento della soglia di avviso"

#: package/contents/ui/ConfigAlerts.qml:59
msgid "Without this, only critical values (red) notify. With it, the warning threshold (orange) notifies too."
msgstr "Senza questa opzione notificano solo i valori critici (rosso). Con essa notifica anche la soglia di avviso (arancione)."

#: package/contents/ui/ConfigAlerts.qml:67
msgid "All-clear when the value is back to normal"
msgstr "Cessato allarme quando il valore torna normale"

#: package/contents/ui/ConfigAlerts.qml:70
msgid "One more notification as soon as the value drops below the threshold again."
msgstr "Un'ulteriore notifica non appena il valore scende di nuovo sotto la soglia."

#: package/contents/ui/ConfigAlerts.qml:77
msgid "Trigger after:"
msgstr "Attiva dopo:"

#: package/contents/ui/ConfigAlerts.qml:83
msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 secondo"
msgstr[1] "%1 secondi"

#: package/contents/ui/ConfigAlerts.qml:88
msgid "A notification is triggered when a value stays above its threshold for this long – short spikes are ignored."
msgstr "Una notifica viene attivata quando un valore resta sopra la sua soglia per questo tempo – i picchi brevi vengono ignorati."

#: package/contents/ui/ConfigAlerts.qml:92
msgid "Warn again only:"
msgstr "Avvisa di nuovo solo:"

#: package/contents/ui/ConfigAlerts.qml:98
msgid "%1 below the threshold"
msgstr "%1 sotto la soglia"

#: package/contents/ui/ConfigAlerts.qml:103
msgid "You are warned again only after the value has dropped below the threshold by this margin in between – in the sensor's unit, e.g. 3 °C or 3 %."
msgstr "Si viene avvisati di nuovo solo dopo che il valore è sceso nel frattempo sotto la soglia di questo margine – nell'unità del sensore, ad es. 3 °C o 3 %."

#: package/contents/ui/ConfigAlerts.qml:107
msgid "Repeat at the earliest after:"
msgstr "Ripeti al più presto dopo:"

#: package/contents/ui/ConfigAlerts.qml:113
msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 minuto"
msgstr[1] "%1 minuti"

#: package/contents/ui/ConfigAlerts.qml:118
msgid "The same sensor notifies at the same level at most once within this time. If it gets worse – from warning to critical – you are notified at once."
msgstr "Lo stesso sensore avvisa allo stesso livello al massimo una volta in questo tempo. Se la situazione peggiora – da avviso a critico – l'avviso arriva subito."

#: package/contents/ui/ConfigAlerts.qml:126
msgid "Thresholds and the “Notify” switch are set per sensor on the “Sensors” page."
msgstr "Le soglie e l'interruttore «Notifica» si impostano per ogni sensore nella pagina «Sensori»."

#: package/contents/ui/ConfigAlerts.qml:129
msgid "Graphics card fans"
msgstr "Ventole della scheda grafica"

#: package/contents/ui/ConfigAlerts.qml:132
msgid "Monitor fans:"
msgstr "Controlla ventole:"

#: package/contents/ui/ConfigAlerts.qml:136
msgid "Warn when a fan stands still or runs too slowly"
msgstr "Avvisa se una ventola si ferma o gira troppo lentamente"

#: package/contents/ui/ConfigAlerts.qml:139
msgid "For NVIDIA cards whose driver reports the measured fan speed. A fan that stands still for 15 seconds although the card wants it to turn is critical. A fan that runs clearly slower than the other fans of the card at the same setting for 30 seconds is a warning – the comparison needs at least two fans. Fans that the card switches off when idle do not trigger anything."
msgstr "Per schede NVIDIA il cui driver riporta la velocità misurata. Una ventola ferma per 15 secondi anche se la scheda la richiede è critica. Una ventola che per 30 secondi gira nettamente più lenta delle altre ventole della scheda con la stessa impostazione genera un avviso – il confronto richiede almeno due ventole. Le ventole che la scheda spegne a riposo non attivano nulla."

#: package/contents/ui/ConfigAlerts.qml:143
msgid "Too slow below:"
msgstr "Troppo lenta sotto:"

#: package/contents/ui/ConfigAlerts.qml:149
msgid "Off (standstill only)"
msgstr "Disattivato (solo arresto)"

#: package/contents/ui/ConfigAlerts.qml:151
#, no-javascript-format
msgid "%1 % of the fastest fan"
msgstr "%1 % della ventola più veloce"

#: package/contents/ui/ConfigAlerts.qml:156
msgid "A fan counts as too slow when it turns slower than this share of the fastest fan of the card. “Off”: only a fan that stands still is reported."
msgstr "Una ventola è considerata troppo lenta quando gira più piano di questa quota della ventola più veloce della scheda. «Disattivato»: viene segnalata solo una ventola ferma."

#: package/contents/ui/ConfigAlerts.qml:165
msgid "Send test notification"
msgstr "Invia notifica di prova"

#: package/contents/ui/ConfigAlerts.qml:169
msgid "Sends a sample notification, so you can see what it looks like and whether it arrives."
msgstr "Invia una notifica di esempio, per vedere come appare e se arriva."

#: package/contents/ui/ConfigAlerts.qml:179
#: package/contents/ui/ConfigAppearance.qml:312
msgid "Reset a single setting: right-click it, or click it with the middle mouse button (scroll wheel)."
msgstr "Ripristinare una singola impostazione: clic destro su di essa, oppure clic con il tasto centrale (rotellina)."

#: package/contents/ui/ConfigAlerts.qml:184
#: package/contents/ui/ConfigAppearance.qml:317
msgid "Restore defaults"
msgstr "Ripristina predefiniti"

#: package/contents/ui/ConfigAlerts.qml:195
#: package/contents/ui/ConfigAppearance.qml:328
msgid "Reset. It takes effect only after “Apply” – “Cancel” keeps everything as it was."
msgstr "Ripristinato. Ha effetto solo dopo «Applica» – «Annulla» lascia tutto com'era."

#: package/contents/ui/ConfigAlerts.qml:196
msgid "Only affects the general settings on this page – your sensor tiles, their thresholds and the per-sensor “Notify” switch are kept."
msgstr "Riguarda solo le impostazioni generali di questa pagina – i riquadri dei sensori, le loro soglie e l'interruttore «Notifica» di ogni sensore vengono mantenuti."

#: package/contents/ui/ConfigAlerts.qml:206
msgid "VRAM temperature critical: 102 °C"
msgstr "Temperatura VRAM critica: 102 °C"

#: package/contents/ui/ConfigAlerts.qml:207
msgid ""
"Critical threshold of 100 °C exceeded.\n"
"(This is just a test from Hardware Tiles.)"
msgstr ""
"Soglia critica di 100 °C superata.\n"
"(Questo è solo un test di Hardware Tiles.)"

#: package/contents/ui/ConfigAppearance.qml:77
msgid "Columns:"
msgstr "Colonne:"

#: package/contents/ui/ConfigAppearance.qml:82
#: package/contents/ui/ConfigSensors.qml:465
#: package/contents/ui/ConfigSensors.qml:657
msgid "Automatic"
msgstr "Automatico"

#: package/contents/ui/ConfigAppearance.qml:87
msgid "“Automatic”: the number of columns at which the tiles get biggest in the widget's size."
msgstr "«Automatico»: il numero di colonne con cui i riquadri risultano più grandi nella dimensione del widget."

#: package/contents/ui/ConfigAppearance.qml:91
msgid "On the desktop:"
msgstr "Sul desktop:"

#: package/contents/ui/ConfigAppearance.qml:95
msgid "Shrink tiles so everything fits without scrolling"
msgstr "Rimpicciolisci i riquadri perché tutto entri senza scorrere"

#: package/contents/ui/ConfigAppearance.qml:98
msgid "All tiles get smaller together until they fit into the widget – no scroll bar needed. Without it, the tiles keep their size and the view can be scrolled."
msgstr "Tutti i riquadri si rimpiccioliscono insieme finché entrano nel widget – senza barra di scorrimento. Senza questa opzione mantengono la loro dimensione e la vista si può scorrere."

#: package/contents/ui/ConfigAppearance.qml:102
msgid "Tile style:"
msgstr "Stile dei riquadri:"

#: package/contents/ui/ConfigAppearance.qml:109
#: package/contents/ui/FullView.qml:832
msgid "Glass (subtle)"
msgstr "Vetro (discreto)"

#: package/contents/ui/ConfigAppearance.qml:110
#: package/contents/ui/FullView.qml:833
msgid "Filled"
msgstr "Pieno"

#: package/contents/ui/ConfigAppearance.qml:111
#: package/contents/ui/FullView.qml:834
msgid "Outline (accent colour)"
msgstr "Contorno (colore d'accento)"

#: package/contents/ui/ConfigAppearance.qml:117
msgid "Glass: subtly see-through · Filled: solid surface · Outline: only a frame in the accent colour"
msgstr "Vetro: leggermente trasparente · Pieno: superficie coprente · Contorno: solo una cornice nel colore di risalto"

#: package/contents/ui/ConfigAppearance.qml:121
msgid "Size:"
msgstr "Dimensione:"

#: package/contents/ui/ConfigAppearance.qml:130
msgid "Scales text, rings and spacing of all tiles."
msgstr "Ridimensiona testo, anelli e spaziature di tutti i riquadri."

#: package/contents/ui/ConfigAppearance.qml:134
msgid "Background opacity:"
msgstr "Opacità dello sfondo:"

#: package/contents/ui/ConfigAppearance.qml:143
msgid "Only on the desktop. The less background, the more solid the tiles get, so values stay readable on any wallpaper – “Tile opacity” sets how solid they are at 0 %. 100 % background is the normal Plasma background."
msgstr "Solo sul desktop. Meno sfondo c'è, più i riquadri diventano opachi, così i valori restano leggibili su qualsiasi sfondo – «Opacità dei riquadri» imposta quanto sono opachi allo 0 %. 100 % di sfondo è lo sfondo normale di Plasma."

#: package/contents/ui/ConfigAppearance.qml:147
msgid "Tile opacity:"
msgstr "Opacità dei riquadri:"

#: package/contents/ui/ConfigAppearance.qml:158
#, no-javascript-format
msgid "How solid the tiles get when the background is faded out completely. Only available below 100 % background."
msgstr "Quanto diventano coprenti i riquadri quando lo sfondo è del tutto attenuato. Disponibile solo sotto il 100 % di sfondo."

#: package/contents/ui/ConfigAppearance.qml:162
msgid "Tooltips:"
msgstr "Suggerimenti:"

#: package/contents/ui/ConfigAppearance.qml:166
msgid "Show details when the mouse pointer rests on a tile"
msgstr "Mostra i dettagli quando il puntatore resta su un riquadro"

#: package/contents/ui/ConfigAppearance.qml:169
msgid "The tooltip shows the full name, the current values and a short explanation of the tile."
msgstr "Il suggerimento mostra il nome completo, i valori attuali e una breve spiegazione del riquadro."

#: package/contents/ui/ConfigAppearance.qml:173
msgid "Tooltip delay:"
msgstr "Ritardo dei suggerimenti:"

#: package/contents/ui/ConfigAppearance.qml:177
#: package/contents/ui/ConfigAppearance.qml:184
#: package/contents/ui/ConfigAppearance.qml:195
#: package/contents/ui/ConfigAppearance.qml:204
#: package/contents/ui/ConfigAppearance.qml:215
#: package/contents/ui/ConfigAppearance.qml:273
msgid "%1 s"
msgstr "%1 s"

#: package/contents/ui/ConfigAppearance.qml:183
msgid "Immediately"
msgstr "Subito"

#: package/contents/ui/ConfigAppearance.qml:187
msgid "How long the mouse pointer has to rest on a tile before its tooltip appears."
msgstr "Per quanto tempo il puntatore deve restare su un riquadro prima che appaia il suo suggerimento."

#: package/contents/ui/ConfigAppearance.qml:191
msgid "Tooltip duration:"
msgstr "Durata dei suggerimenti:"

#: package/contents/ui/ConfigAppearance.qml:195
#: package/contents/ui/ConfigAppearance.qml:204
msgid "Unlimited"
msgstr "Illimitata"

#: package/contents/ui/ConfigAppearance.qml:207
msgid "“Unlimited”: the tooltip stays as long as the mouse pointer rests on the tile."
msgstr "«Illimitata»: il suggerimento resta finché il puntatore rimane sul riquadro."

#: package/contents/ui/ConfigAppearance.qml:211
msgid "Highlight moved tile:"
msgstr "Evidenzia il riquadro spostato:"

#: package/contents/ui/ConfigAppearance.qml:215
#: package/contents/ui/ResetHandler.qml:30
msgid "Off"
msgstr "Disattivo"

#: package/contents/ui/ConfigAppearance.qml:220
msgid "In “Edit tiles”: how long a tile flashes at its new place after it was moved."
msgstr "In «Modifica riquadri»: per quanto tempo un riquadro lampeggia nella nuova posizione dopo lo spostamento."

#: package/contents/ui/ConfigAppearance.qml:225
msgid "Sections per graphics card:"
msgstr "Sezioni per scheda grafica:"

#: package/contents/ui/ConfigAppearance.qml:232
#: package/contents/ui/FullView.qml:843
msgid "From two graphics cards"
msgstr "Da due schede grafiche"

#: package/contents/ui/ConfigAppearance.qml:233
#: package/contents/ui/FullView.qml:844
msgid "Always (even with one card)"
msgstr "Sempre (anche con una scheda)"

#: package/contents/ui/ConfigAppearance.qml:234
#: package/contents/ui/FullView.qml:845
msgid "Never (several cards: coloured edge)"
msgstr "Mai (più schede: bordo colorato)"

#: package/contents/ui/ConfigAppearance.qml:240
msgid "Every graphics card gets its own heading, its tiles below it."
msgstr "Ogni scheda grafica riceve una propria intestazione, con i suoi riquadri sotto."

#: package/contents/ui/ConfigAppearance.qml:248
msgid "Move, remove or add tiles right in the widget: right-click → “Edit tiles”."
msgstr "I riquadri si possono spostare, rimuovere o aggiungere direttamente nel widget: clic destro → «Modifica riquadri»."

#: package/contents/ui/ConfigAppearance.qml:254
msgid "Update:"
msgstr "Aggiornamento:"

#: package/contents/ui/ConfigAppearance.qml:259
msgid "every %1 s"
msgstr "ogni %1 s"

#: package/contents/ui/ConfigAppearance.qml:264
msgid "How often the values are read. Shorter looks smoother but costs a little more computing time."
msgstr "Ogni quanto vengono letti i valori. Più breve appare più fluido, ma richiede un po' più di tempo di calcolo."

#: package/contents/ui/ConfigAppearance.qml:268
msgid "History in graphs:"
msgstr "Cronologia nei grafici:"

#: package/contents/ui/ConfigAppearance.qml:273
msgid "%1 min"
msgstr "%1 min"

#: package/contents/ui/ConfigAppearance.qml:278
msgid "Which period of time a history graph shows."
msgstr "Quale periodo di tempo mostra un grafico della cronologia."

#: package/contents/ui/ConfigAppearance.qml:282
msgid "Panel"
msgstr "Pannello"

#: package/contents/ui/ConfigAppearance.qml:285
msgid "In the panel:"
msgstr "Nel pannello:"

#: package/contents/ui/ConfigAppearance.qml:289
msgid "Show mini rings"
msgstr "Mostra mini anelli"

#: package/contents/ui/ConfigAppearance.qml:292
msgid "Which sensors appear in the panel is set per entry on the “Sensors” page. The widget's background on the desktop can be switched in edit mode."
msgstr "Quali sensori compaiono nel pannello si imposta per ogni voce nella pagina «Sensori». Lo sfondo del widget sul desktop si può cambiare in modalità modifica."

#: package/contents/ui/ConfigAppearance.qml:299
msgid "Show labels"
msgstr "Mostra etichette"

#: package/contents/ui/ConfigAppearance.qml:302
msgid "Shows the name of the sensor next to the value in the panel."
msgstr "Mostra il nome del sensore accanto al valore nel pannello."

#: package/contents/ui/ConfigAppearance.qml:329
msgid "Only affects the settings on this page – your sensor tiles and notifications are kept."
msgstr "Riguarda solo le impostazioni di questa pagina – i riquadri dei sensori e le notifiche vengono mantenuti."

#: package/contents/ui/ConfigProfiles.qml:43
msgid "Saved as “%1”."
msgstr "Salvato come «%1»."

#: package/contents/ui/ConfigProfiles.qml:48
msgid "“%2” loaded. %1 tile belongs to a graphics card this computer does not have – it stays empty."
msgid_plural "“%2” loaded. %1 tiles belong to a graphics card this computer does not have – they stay empty."
msgstr[0] "«%2» caricato. %1 riquadro appartiene a una scheda grafica che questo computer non ha – resta vuoto."
msgstr[1] "«%2» caricato. %1 riquadri appartengono a una scheda grafica che questo computer non ha – restano vuoti."

#: package/contents/ui/ConfigProfiles.qml:51
msgid "“%1” loaded."
msgstr "«%1» caricato."

#: package/contents/ui/ConfigProfiles.qml:56
msgid "“%1” deleted."
msgstr "«%1» eliminato."

#: package/contents/ui/ConfigProfiles.qml:61
msgid "A profile named “%1” already exists."
msgstr "Esiste già un profilo chiamato «%1»."

#: package/contents/ui/ConfigProfiles.qml:91
msgid "Imported: %2"
msgid_plural "%1 profiles imported: %2"
msgstr[0] "Importato: %2"
msgstr[1] "%1 profili importati: %2"

#: package/contents/ui/ConfigProfiles.qml:102
msgid "The file could not be saved."
msgstr "Impossibile salvare il file."

#: package/contents/ui/ConfigProfiles.qml:102
msgid "The file could not be read."
msgstr "Impossibile leggere il file."

#: package/contents/ui/ConfigProfiles.qml:107
msgid "Profile exported."
msgid_plural "%1 profiles exported."
msgstr[0] "Profilo esportato."
msgstr[1] "%1 profili esportati."

#: package/contents/ui/ConfigProfiles.qml:112
msgid "This file does not contain Hardware Tiles profiles."
msgstr "Questo file non contiene profili di Hardware Tiles."

#: package/contents/ui/ConfigProfiles.qml:133
#: package/contents/ui/ConfigProfiles.qml:140
msgid "Hardware Tiles profiles (*.json)"
msgstr "Profili di Hardware Tiles (*.json)"

#: package/contents/ui/ConfigProfiles.qml:140
msgid "All files (*)"
msgstr "Tutti i file (*)"

#: package/contents/ui/ConfigProfiles.qml:147
msgid "This profile runs commands"
msgstr "Questo profilo esegue comandi"

#: package/contents/ui/ConfigProfiles.qml:148
msgid "Some tiles in it run these shell commands on this computer every few seconds:"
msgstr "Alcuni riquadri eseguono questi comandi shell su questo computer ogni pochi secondi:"

#: package/contents/ui/ConfigProfiles.qml:150
msgid "Only import profiles from sources you trust."
msgstr "Importare profili solo da fonti affidabili."

#: package/contents/ui/ConfigProfiles.qml:154
msgid "Import anyway"
msgstr "Importa comunque"

#: package/contents/ui/ConfigProfiles.qml:168
msgid "Delete profile"
msgstr "Elimina profilo"

#: package/contents/ui/ConfigProfiles.qml:169
msgid "Delete the profile “%1”? The current view stays as it is."
msgstr "Eliminare il profilo «%1»? La vista attuale resta invariata."

#: package/contents/ui/ConfigProfiles.qml:176
msgid "Replace profile"
msgstr "Sostituisci profilo"

#: package/contents/ui/ConfigProfiles.qml:177
msgid "A profile named “%1” already exists. Replace it with the current view?"
msgstr "Esiste già un profilo chiamato «%1». Sostituirlo con la vista attuale?"

#: package/contents/ui/ConfigProfiles.qml:184
msgid "Rename profile"
msgstr "Rinomina profilo"

#: package/contents/ui/ConfigProfiles.qml:200
