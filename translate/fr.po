#: package/contents/config/config.qml:9
msgid "Sensors"
msgstr "Capteurs"

#: package/contents/config/config.qml:14 package/contents/ui/FullView.qml:1183
msgid "Notifications"
msgstr "Notifications"

#: package/contents/config/config.qml:19 package/contents/ui/FullView.qml:1152
msgid "Appearance"
msgstr "Apparence"

#: package/contents/config/config.qml:24
#: package/contents/ui/ConfigSensors.qml:79
msgid "Profiles"
msgstr "Profils"

#: package/contents/config/config.qml:29
msgid "About & updates"
msgstr "À propos et mises à jour"

#: package/contents/ui/ConfigAbout.qml:51
msgid "Exit code %1"
msgstr "Code de sortie %1"

#: package/contents/ui/ConfigAbout.qml:56
msgid "Restart Plasma desktop?"
msgstr "Redémarrer le bureau Plasma ?"

#: package/contents/ui/ConfigAbout.qml:57
msgid "Desktop, panels and widgets disappear for a few seconds and then start again. Open programs keep running. This settings window closes – changes that have not been applied are lost."
msgstr "Le bureau, les tableaux de bord et les widgets disparaissent quelques secondes puis redémarrent. Les programmes ouverts continuent de fonctionner. Cette fenêtre de configuration se ferme – les modifications non appliquées sont perdues."

#: package/contents/ui/ConfigAbout.qml:61
msgid "Restart"
msgstr "Redémarrer"

#: package/contents/ui/ConfigAbout.qml:70
#: package/contents/ui/ConfigProfiles.qml:159
#: package/contents/ui/SetupWizard.qml:372
msgid "Cancel"
msgstr "Annuler"

#: package/contents/ui/ConfigAbout.qml:96
msgid "Version:"
msgstr "Version :"

#: package/contents/ui/ConfigAbout.qml:100
msgid "Licence:"
msgstr "Licence :"

#: package/contents/ui/ConfigAbout.qml:104
msgid "Links:"
msgstr "Liens :"

#: package/contents/ui/ConfigAbout.qml:106
msgid "Website"
msgstr "Site web"

#: package/contents/ui/ConfigAbout.qml:111
msgid "Report a problem"
msgstr "Signaler un problème"

#: package/contents/ui/ConfigAbout.qml:116
msgid "Hardware not detected"
msgstr "Matériel non détecté"

#: package/contents/ui/ConfigAbout.qml:121
msgid "“Report a problem” and “Hardware not detected” each open a form on GitHub."
msgstr "« Signaler un problème » et « Matériel non détecté » ouvrent chacun un formulaire sur GitHub."

#: package/contents/ui/ConfigAbout.qml:128
msgid "Updates:"
msgstr "Mises à jour :"

#: package/contents/ui/ConfigAbout.qml:131
msgid "Look for new versions once a week"
msgstr "Rechercher de nouvelles versions une fois par semaine"

#: package/contents/ui/ConfigAbout.qml:136
msgid "Once a week the widget asks GitHub for the newest version number and shows a note in the widget when a new version is out."
msgstr "Une fois par semaine, le widget demande à GitHub le numéro de la dernière version et affiche une note dans le widget lorsqu'une nouvelle version est sortie."

#: package/contents/ui/ConfigAbout.qml:141
msgid "Check now"
msgstr "Vérifier maintenant"

#: package/contents/ui/ConfigAbout.qml:155
msgid "You have the latest version."
msgstr "Vous avez la dernière version."

#: package/contents/ui/ConfigAbout.qml:156
msgid "Version %1 is available."
msgstr "La version %1 est disponible."

#: package/contents/ui/ConfigAbout.qml:157
msgid "No version has been published yet."
msgstr "Aucune version n’a encore été publiée."

#: package/contents/ui/ConfigAbout.qml:158
msgid "GitHub could not be reached (%1)."
msgstr "GitHub n’a pas pu être joint (%1)."

#: package/contents/ui/ConfigAbout.qml:165 package/contents/ui/FullView.qml:586
msgid "Open download page"
msgstr "Ouvrir la page de téléchargement"

#: package/contents/ui/ConfigAbout.qml:170
msgid "Installed via “Get New Widgets” or Discover? Then Discover installs updates for you – the check here only informs you."
msgstr "Installé via « Obtenir de nouveaux widgets » ou Discover ? Discover installe alors les mises à jour pour vous – la vérification ici sert seulement d’information."

#: package/contents/ui/ConfigAbout.qml:180
msgid "Privacy: the check only runs when you allow it or click “Check now”. Your computer then asks api.github.com for the newest version number. GitHub sees your IP address, as with any website visit; Hardware Tiles sends no other data and keeps no statistics. Details: <a href=\"%1\">GitHub privacy statement</a>."
msgstr "Confidentialité : la vérification n’a lieu que si vous l’autorisez ou cliquez sur « Vérifier maintenant ». Votre ordinateur demande alors à api.github.com le numéro de la dernière version. GitHub voit votre adresse IP, comme lors de toute visite d’un site web ; Hardware Tiles n’envoie aucune autre donnée et ne tient aucune statistique. Détails : <a href=\"%1\">déclaration de confidentialité de GitHub</a>."

#: package/contents/ui/ConfigAbout.qml:187
msgid "Troubleshooting:"
msgstr "Dépannage :"

#: package/contents/ui/ConfigAbout.qml:189
msgid "Restart Plasma desktop …"
msgstr "Redémarrer le bureau Plasma…"

#: package/contents/ui/ConfigAbout.qml:194
msgid "Helps when the widget or the desktop no longer reacts properly, e.g. after an update. Same as “systemctl --user restart plasma-plasmashell” in a terminal. If it happens again, please report it with “Report a problem”."
msgstr "Utile lorsque le widget ou le bureau ne réagit plus correctement, p. ex. après une mise à jour. Équivaut à “systemctl --user restart plasma-plasmashell” dans un terminal. Si cela se reproduit, merci de le signaler via « Signaler un problème »."

#: package/contents/ui/ConfigAbout.qml:202
msgid "Plasma could not be restarted: %1"
msgstr "Impossible de redémarrer Plasma : %1"

#: package/contents/ui/ConfigAlerts.qml:41
msgid "Notifications:"
msgstr "Notifications :"

#: package/contents/ui/ConfigAlerts.qml:45
msgid "Notify on critical values"
msgstr "Notifier en cas de valeurs critiques"

#: package/contents/ui/ConfigAlerts.qml:48
msgid "Critical notifications stay until you close them and also appear in “Do not disturb” mode."
msgstr "Les notifications critiques restent affichées jusqu'à ce que vous les fermiez et apparaissent aussi en mode « Ne pas déranger »."

#: package/contents/ui/ConfigAlerts.qml:56
msgid "Also when the warning threshold is reached"
msgstr "Aussi lorsque le seuil d'avertissement est atteint"

#: package/contents/ui/ConfigAlerts.qml:59
msgid "Without this, only critical values (red) notify. With it, the warning threshold (orange) notifies too."
msgstr "Sans cette option, seules les valeurs critiques (rouge) notifient. Avec elle, le seuil d'avertissement (orange) notifie aussi."

#: package/contents/ui/ConfigAlerts.qml:67
msgid "All-clear when the value is back to normal"
msgstr "Fin d'alerte lorsque la valeur redevient normale"

#: package/contents/ui/ConfigAlerts.qml:70
msgid "One more notification as soon as the value drops below the threshold again."
msgstr "Une notification de plus dès que la valeur repasse sous le seuil."

#: package/contents/ui/ConfigAlerts.qml:77
msgid "Trigger after:"
msgstr "Déclencher après :"

#: package/contents/ui/ConfigAlerts.qml:83
msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 seconde"
msgstr[1] "%1 secondes"

#: package/contents/ui/ConfigAlerts.qml:88
msgid "A notification is triggered when a value stays above its threshold for this long – short spikes are ignored."
msgstr "Une notification est déclenchée lorsqu'une valeur reste au-dessus de son seuil pendant cette durée – les pics brefs sont ignorés."

#: package/contents/ui/ConfigAlerts.qml:92
msgid "Warn again only:"
msgstr "Avertir à nouveau seulement :"

#: package/contents/ui/ConfigAlerts.qml:98
msgid "%1 below the threshold"
msgstr "%1 sous le seuil"

#: package/contents/ui/ConfigAlerts.qml:103
msgid "You are warned again only after the value has dropped below the threshold by this margin in between – in the sensor's unit, e.g. 3 °C or 3 %."
msgstr "Un nouvel avertissement n'a lieu qu'après que la valeur est entre-temps redescendue sous le seuil de cet écart – dans l'unité du capteur, p. ex. 3 °C ou 3 %."

#: package/contents/ui/ConfigAlerts.qml:107
msgid "Repeat at the earliest after:"
msgstr "Répéter au plus tôt après :"

#: package/contents/ui/ConfigAlerts.qml:113
msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 minute"
msgstr[1] "%1 minutes"

#: package/contents/ui/ConfigAlerts.qml:118
msgid "The same sensor notifies at the same level at most once within this time. If it gets worse – from warning to critical – you are notified at once."
msgstr "Un même capteur ne notifie qu'une fois au plus par niveau pendant cette durée. Si la situation s'aggrave – d'avertissement à critique –, la notification arrive immédiatement."

#: package/contents/ui/ConfigAlerts.qml:126
msgid "Thresholds and the “Notify” switch are set per sensor on the “Sensors” page."
msgstr "Les seuils et l'interrupteur « Notifier » se règlent par capteur sur la page « Capteurs »."

#: package/contents/ui/ConfigAlerts.qml:129
msgid "Graphics card fans"
msgstr "Ventilateurs de la carte graphique"

#: package/contents/ui/ConfigAlerts.qml:132
msgid "Monitor fans:"
msgstr "Surveiller les ventilateurs :"

#: package/contents/ui/ConfigAlerts.qml:136
msgid "Warn when a fan stands still or runs too slowly"
msgstr "Avertir si un ventilateur s'arrête ou tourne trop lentement"

#: package/contents/ui/ConfigAlerts.qml:139
msgid "For NVIDIA cards whose driver reports the measured fan speed. A fan that stands still for 15 seconds although the card wants it to turn is critical. A fan that runs clearly slower than the other fans of the card at the same setting for 30 seconds is a warning – the comparison needs at least two fans. Fans that the card switches off when idle do not trigger anything."
msgstr "Pour les cartes NVIDIA dont le pilote indique la vitesse mesurée. Un ventilateur arrêté pendant 15 secondes alors que la carte en a besoin est critique. Un ventilateur nettement plus lent que les autres ventilateurs de la carte au même réglage pendant 30 secondes déclenche un avertissement – la comparaison nécessite au moins deux ventilateurs. Les ventilateurs que la carte coupe au repos ne déclenchent rien."

#: package/contents/ui/ConfigAlerts.qml:143
msgid "Too slow below:"
msgstr "Trop lent en dessous de :"

#: package/contents/ui/ConfigAlerts.qml:149
msgid "Off (standstill only)"
msgstr "Désactivé (arrêt uniquement)"

#: package/contents/ui/ConfigAlerts.qml:151
#, no-javascript-format
msgid "%1 % of the fastest fan"
msgstr "%1 % du ventilateur le plus rapide"

#: package/contents/ui/ConfigAlerts.qml:156
msgid "A fan counts as too slow when it turns slower than this share of the fastest fan of the card. “Off”: only a fan that stands still is reported."
msgstr "Un ventilateur est considéré trop lent lorsqu'il tourne moins vite que cette part du ventilateur le plus rapide de la carte. « Désactivé » : seul un ventilateur à l'arrêt est signalé."

#: package/contents/ui/ConfigAlerts.qml:165
msgid "Send test notification"
msgstr "Envoyer une notification de test"

#: package/contents/ui/ConfigAlerts.qml:169
msgid "Sends a sample notification, so you can see what it looks like and whether it arrives."
msgstr "Envoie une notification d'exemple, pour voir à quoi elle ressemble et si elle arrive."

#: package/contents/ui/ConfigAlerts.qml:179
#: package/contents/ui/ConfigAppearance.qml:326
msgid "Reset a single setting: right-click it, or click it with the middle mouse button (scroll wheel)."
msgstr "Réinitialiser un seul réglage : clic droit dessus, ou clic avec le bouton du milieu (molette)."

#: package/contents/ui/ConfigAlerts.qml:184
#: package/contents/ui/ConfigAppearance.qml:331
msgid "Restore defaults"
msgstr "Restaurer les valeurs par défaut"

#: package/contents/ui/ConfigAlerts.qml:195
#: package/contents/ui/ConfigAppearance.qml:342
msgid "Reset. It takes effect only after “Apply” – “Cancel” keeps everything as it was."
msgstr "Réinitialisé. Prend effet seulement après « Appliquer » – « Annuler » laisse tout tel quel."

#: package/contents/ui/ConfigAlerts.qml:196
msgid "Only affects the general settings on this page – your sensor tiles, their thresholds and the per-sensor “Notify” switch are kept."
msgstr "Ne concerne que les réglages généraux de cette page – vos tuiles de capteurs, leurs seuils et l'interrupteur « Notifier » par capteur sont conservés."

#: package/contents/ui/ConfigAlerts.qml:206
msgid "VRAM temperature critical: 102 °C"
msgstr "Température VRAM critique : 102 °C"

#: package/contents/ui/ConfigAlerts.qml:207
msgid ""
"Critical threshold of 100 °C exceeded.\n"
"(This is just a test from Hardware Tiles.)"
msgstr ""
"Seuil critique de 100 °C dépassé.\n"
"(Ceci n'est qu'un test de Hardware Tiles.)"

#: package/contents/ui/ConfigAppearance.qml:78
msgid "Columns:"
msgstr "Colonnes :"

#: package/contents/ui/ConfigAppearance.qml:83
#: package/contents/ui/ConfigSensors.qml:465
#: package/contents/ui/ConfigSensors.qml:657
msgid "Automatic"
msgstr "Automatique"

#: package/contents/ui/ConfigAppearance.qml:88
msgid "“Automatic”: the number of columns at which the tiles get biggest in the widget's size."
msgstr "« Automatique » : le nombre de colonnes avec lequel les tuiles sont les plus grandes dans la taille du widget."

#: package/contents/ui/ConfigAppearance.qml:92
msgid "On the desktop:"
msgstr "Sur le bureau :"

#: package/contents/ui/ConfigAppearance.qml:96
msgid "Shrink tiles so everything fits without scrolling"
msgstr "Réduire les tuiles pour que tout tienne sans défilement"

#: package/contents/ui/ConfigAppearance.qml:99
msgid "All tiles get smaller together until they fit into the widget – no scroll bar needed. Without it, the tiles keep their size and the view can be scrolled."
msgstr "Toutes les tuiles rétrécissent ensemble jusqu'à tenir dans le widget – sans barre de défilement. Sans cette option, les tuiles gardent leur taille et la vue peut défiler."

#: package/contents/ui/ConfigAppearance.qml:103
msgid "Tile style:"
msgstr "Style des tuiles :"

#: package/contents/ui/ConfigAppearance.qml:110
#: package/contents/ui/FullView.qml:1049
msgid "Glass (subtle)"
msgstr "Verre (discret)"

#: package/contents/ui/ConfigAppearance.qml:111
#: package/contents/ui/FullView.qml:1050
msgid "Filled"
msgstr "Plein"

#: package/contents/ui/ConfigAppearance.qml:112
#: package/contents/ui/FullView.qml:1051
msgid "Outline (accent colour)"
msgstr "Contour (couleur d'accent)"

#: package/contents/ui/ConfigAppearance.qml:118
msgid "Glass: subtly see-through · Filled: solid surface · Outline: only a frame in the accent colour"
msgstr "Verre : légèrement transparent · Rempli : surface opaque · Contour : seulement un cadre dans la couleur d'accentuation"

#: package/contents/ui/ConfigAppearance.qml:122
msgid "Size:"
msgstr "Taille :"

#: package/contents/ui/ConfigAppearance.qml:131
msgid "Scales text, rings and spacing of all tiles."
msgstr "Met à l'échelle le texte, les anneaux et les espacements de toutes les tuiles."

#: package/contents/ui/ConfigAppearance.qml:135
msgid "Background opacity:"
msgstr "Opacité de l'arrière-plan :"

#: package/contents/ui/ConfigAppearance.qml:144
msgid "Only on the desktop. The less background, the more solid the tiles get, so values stay readable on any wallpaper – “Tile opacity” sets how solid they are at 0 %. 100 % background is the normal Plasma background."
msgstr "Uniquement sur le bureau. Moins il y a d'arrière-plan, plus les tuiles deviennent opaques, pour que les valeurs restent lisibles sur tout fond d'écran – « Opacité des tuiles » règle leur opacité à 0 %. 100 % d'arrière-plan correspond à l'arrière-plan normal de Plasma."

#: package/contents/ui/ConfigAppearance.qml:148
msgid "Tile opacity:"
msgstr "Opacité des tuiles :"

#: package/contents/ui/ConfigAppearance.qml:159
#, no-javascript-format
msgid "How solid the tiles get when the background is faded out completely. Only available below 100 % background."
msgstr "Degré d'opacité des tuiles lorsque l'arrière-plan est entièrement estompé. Disponible uniquement en dessous de 100 % d'arrière-plan."

#: package/contents/ui/ConfigAppearance.qml:163
msgid "Tooltips:"
msgstr "Infobulles :"

#: package/contents/ui/ConfigAppearance.qml:167
msgid "Show details when the mouse pointer rests on a tile"
msgstr "Afficher les détails lorsque le pointeur reste sur une tuile"

#: package/contents/ui/ConfigAppearance.qml:170
msgid "The tooltip shows the full name, the current values and a short explanation of the tile."
msgstr "L'infobulle affiche le nom complet, les valeurs actuelles et une brève explication de la tuile."

#: package/contents/ui/ConfigAppearance.qml:174
msgid "Tooltip delay:"
msgstr "Délai des infobulles :"

#: package/contents/ui/ConfigAppearance.qml:178
#: package/contents/ui/ConfigAppearance.qml:185
#: package/contents/ui/ConfigAppearance.qml:196
#: package/contents/ui/ConfigAppearance.qml:205
#: package/contents/ui/ConfigAppearance.qml:216
#: package/contents/ui/ConfigAppearance.qml:229
#: package/contents/ui/ConfigAppearance.qml:287
msgid "%1 s"
msgstr "%1 s"

#: package/contents/ui/ConfigAppearance.qml:184
msgid "Immediately"
msgstr "Immédiatement"

#: package/contents/ui/ConfigAppearance.qml:188
msgid "How long the mouse pointer has to rest on a tile before its tooltip appears."
msgstr "Durée pendant laquelle le pointeur doit rester sur une tuile avant que son infobulle apparaisse."

#: package/contents/ui/ConfigAppearance.qml:192
msgid "Tooltip duration:"
msgstr "Durée des infobulles :"

#: package/contents/ui/ConfigAppearance.qml:196
#: package/contents/ui/ConfigAppearance.qml:205
msgid "Unlimited"
msgstr "Illimitée"

#: package/contents/ui/ConfigAppearance.qml:208
msgid "“Unlimited”: the tooltip stays as long as the mouse pointer rests on the tile."
msgstr "« Illimitée » : l'infobulle reste affichée tant que le pointeur reste sur la tuile."

#: package/contents/ui/ConfigAppearance.qml:212
msgid "Highlight moved tile:"
msgstr "Mettre en évidence la tuile déplacée :"

#: package/contents/ui/ConfigAppearance.qml:216
#: package/contents/ui/ConfigAppearance.qml:229
#: package/contents/ui/ResetHandler.qml:30
msgid "Off"
msgstr "Désactivé"

#: package/contents/ui/ConfigAppearance.qml:221
msgid "In “Edit tiles”: how long a tile flashes at its new place after it was moved."
msgstr "Dans « Modifier les tuiles » : durée pendant laquelle une tuile clignote à sa nouvelle place après avoir été déplacée."

#: package/contents/ui/ConfigAppearance.qml:225
msgid "Fade out removed tile:"
msgstr "Estomper la tuile supprimée :"

#: package/contents/ui/ConfigAppearance.qml:234
msgid "In “Edit tiles”: how long a removed tile (× or Delete) turns red and fades out before the others move up. “Off”: it disappears at once."
msgstr "Dans « Modifier les tuiles » : durée pendant laquelle une tuile supprimée (× ou Suppr) devient rouge et s’estompe avant que les autres ne remontent. « Désactivé » : elle disparaît aussitôt."

#: package/contents/ui/ConfigAppearance.qml:239
msgid "Sections per graphics card:"
msgstr "Sections par carte graphique :"

#: package/contents/ui/ConfigAppearance.qml:246
#: package/contents/ui/FullView.qml:1060
msgid "From two graphics cards"
msgstr "À partir de deux cartes graphiques"

#: package/contents/ui/ConfigAppearance.qml:247
#: package/contents/ui/FullView.qml:1061
msgid "Always (even with one card)"
msgstr "Toujours (même avec une seule carte)"

#: package/contents/ui/ConfigAppearance.qml:248
#: package/contents/ui/FullView.qml:1062
msgid "Never (several cards: coloured edge)"
msgstr "Jamais (plusieurs cartes : bord coloré)"

#: package/contents/ui/ConfigAppearance.qml:254
msgid "Every graphics card gets its own heading, its tiles below it."
msgstr "Chaque carte graphique reçoit son propre titre, avec ses tuiles en dessous."

#: package/contents/ui/ConfigAppearance.qml:262
msgid "Move, remove or add tiles right in the widget: right-click → “Edit tiles”."
msgstr "Déplacer, supprimer ou ajouter des tuiles directement dans le widget : clic droit → « Modifier les tuiles »."

#: package/contents/ui/ConfigAppearance.qml:268
msgid "Update:"
msgstr "Actualisation :"

#: package/contents/ui/ConfigAppearance.qml:273
msgid "every %1 s"
msgstr "toutes les %1 s"

#: package/contents/ui/ConfigAppearance.qml:278
msgid "How often the values are read. Shorter looks smoother but costs a little more computing time."
msgstr "À quelle fréquence les valeurs sont lues. Plus court paraît plus fluide, mais demande un peu plus de temps de calcul."

#: package/contents/ui/ConfigAppearance.qml:282
msgid "History in graphs:"
msgstr "Historique des graphiques :"

#: package/contents/ui/ConfigAppearance.qml:287
msgid "%1 min"
msgstr "%1 min"

#: package/contents/ui/ConfigAppearance.qml:292
msgid "Which period of time a history graph shows."
msgstr "Quelle période un graphique d'historique affiche."

#: package/contents/ui/ConfigAppearance.qml:296
msgid "Panel"
msgstr "Panneau"

#: package/contents/ui/ConfigAppearance.qml:299
msgid "In the panel:"
msgstr "Dans le panneau :"

#: package/contents/ui/ConfigAppearance.qml:303
msgid "Show mini rings"
msgstr "Afficher des mini-anneaux"

#: package/contents/ui/ConfigAppearance.qml:306
msgid "Which sensors appear in the panel is set per entry on the “Sensors” page. The widget's background on the desktop can be switched in edit mode."
msgstr "Les capteurs affichés dans le panneau se règlent par entrée sur la page « Capteurs ». L'arrière-plan du widget sur le bureau se change en mode édition."

#: package/contents/ui/ConfigAppearance.qml:313
msgid "Show labels"
msgstr "Afficher les libellés"

#: package/contents/ui/ConfigAppearance.qml:316
msgid "Shows the name of the sensor next to the value in the panel."
msgstr "Affiche le nom du capteur à côté de la valeur dans le panneau."

#: package/contents/ui/ConfigAppearance.qml:343
msgid "Only affects the settings on this page – your sensor tiles and notifications are kept."
msgstr "Ne concerne que les réglages de cette page – vos tuiles de capteurs et les notifications sont conservées."

#: package/contents/ui/ConfigProfiles.qml:43
msgid "Saved as “%1”."
msgstr "Enregistré sous « %1 »."

#: package/contents/ui/ConfigProfiles.qml:48
msgid "“%2” loaded. %1 tile belongs to a graphics card this computer does not have – it stays empty."
msgid_plural "“%2” loaded. %1 tiles belong to a graphics card this computer does not have – they stay empty."
msgstr[0] "« %2 » chargé. %1 tuile appartient à une carte graphique absente de cet ordinateur – elle reste vide."
msgstr[1] "« %2 » chargé. %1 tuiles appartiennent à une carte graphique absente de cet ordinateur – elles restent vides."

#: package/contents/ui/ConfigProfiles.qml:51
msgid "“%1” loaded."
msgstr "« %1 » chargé."

#: package/contents/ui/ConfigProfiles.qml:56
msgid "“%1” deleted."
msgstr "« %1 » supprimé."

#: package/contents/ui/ConfigProfiles.qml:61
msgid "A profile named “%1” already exists."
msgstr "Un profil nommé « %1 » existe déjà."

#: package/contents/ui/ConfigProfiles.qml:91
msgid "Imported: %2"
msgid_plural "%1 profiles imported: %2"
msgstr[0] "Importé : %2"
msgstr[1] "%1 profils importés : %2"

#: package/contents/ui/ConfigProfiles.qml:102
msgid "The file could not be saved."
msgstr "Le fichier n’a pas pu être enregistré."

#: package/contents/ui/ConfigProfiles.qml:102
msgid "The file could not be read."
msgstr "Le fichier n’a pas pu être lu."

#: package/contents/ui/ConfigProfiles.qml:107
msgid "Profile exported."
msgid_plural "%1 profiles exported."
msgstr[0] "Profil exporté."
msgstr[1] "%1 profils exportés."

#: package/contents/ui/ConfigProfiles.qml:112
msgid "This file does not contain Hardware Tiles profiles."
msgstr "Ce fichier ne contient pas de profils Hardware Tiles."

#: package/contents/ui/ConfigProfiles.qml:133
#: package/contents/ui/ConfigProfiles.qml:140
msgid "Hardware Tiles profiles (*.json)"
msgstr "Profils Hardware Tiles (*.json)"

#: package/contents/ui/ConfigProfiles.qml:140
msgid "All files (*)"
msgstr "Tous les fichiers (*)"

#: package/contents/ui/ConfigProfiles.qml:147
msgid "This profile runs commands"
msgstr "Ce profil exécute des commandes"

#: package/contents/ui/ConfigProfiles.qml:148
msgid "Some tiles in it run these shell commands on this computer every few seconds:"
msgstr "Certaines tuiles exécutent ces commandes shell sur cet ordinateur toutes les quelques secondes :"

#: package/contents/ui/ConfigProfiles.qml:150
msgid "Only import profiles from sources you trust."
msgstr "N’importez des profils que depuis des sources de confiance."

#: package/contents/ui/ConfigProfiles.qml:154
msgid "Import anyway"
msgstr "Importer quand même"

#: package/contents/ui/ConfigProfiles.qml:168
