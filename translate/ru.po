msgstr "Удалить профиль «%1»? Текущий вид останется без изменений."

#: package/contents/ui/ConfigProfiles.qml:176
msgid "Replace profile"
msgstr "Заменить профиль"

#: package/contents/ui/ConfigProfiles.qml:177
msgid "A profile named “%1” already exists. Replace it with the current view?"
msgstr "Профиль с именем «%1» уже существует. Заменить его текущим видом?"

#: package/contents/ui/ConfigProfiles.qml:184
msgid "Rename profile"
msgstr "Переименовать профиль"

#: package/contents/ui/ConfigProfiles.qml:200
msgid "A profile stores the current view: tiles and their order, appearance and notification settings. Loading a profile replaces the view at once – the previous one can be restored."
msgstr "Профиль сохраняет текущий вид: плитки и их порядок, оформление и уведомления. Загрузка профиля сразу заменяет вид — прежний можно восстановить."

#: package/contents/ui/ConfigProfiles.qml:213
msgid "The view before the last profile was loaded can be restored."
msgstr "Вид до последней загрузки профиля можно восстановить."

#: package/contents/ui/ConfigProfiles.qml:216
#: package/contents/ui/FullView.qml:649
msgid "Undo profile change"
msgstr "Отменить смену профиля"

#: package/contents/ui/ConfigProfiles.qml:218
